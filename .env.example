# Copy this file to .env at the repository root. Never commit real secrets.
# Compose interpolation: always pass --env-file .env in the commands below.
BACKEND_HOST_PORT=8080
PORT=8080

# There are currently no profile-specific config files. Keep the default profile
# until real profile configuration is added.
SPRING_PROFILES_ACTIVE=default

# PostgreSQL connection for the current JPA backend.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ax
SPRING_DATASOURCE_USERNAME=ax
SPRING_DATASOURCE_PASSWORD=

# Set local secrets before starting; never commit real values.
JWT_SECRET=
JWT_TTL=12h
INTERNAL_TOKEN=
CORS_ORIGIN=http://localhost

# Optional JVM options are passed through at runtime, never at image build time.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Agent calls remain disabled by default.
