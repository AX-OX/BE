# Copy this file to .env at the repository root. Never commit real secrets.
# Compose interpolation: always pass --env-file .env in the commands below.
BACKEND_HOST_PORT=8080
PORT=8080

# Cloud SQL Connector configuration in application-cloudsql.yml.
# Local TCP PostgreSQL/Proxy: use default and a normal TCP JDBC URL instead.
SPRING_PROFILES_ACTIVE=cloudsql

# Required at runtime. Cloud SQL Connector resolves the host using the instance.
# Backend project: my-project-axox; Cloud SQL project: axox-db-trial
# Instance: axox-db-trial:asia-northeast1:free-trial-first-project (PostgreSQL 18.6)
INSTANCE_CONNECTION_NAME=axox-db-trial:asia-northeast1:free-trial-first-project
# Required: set PUBLIC or PRIVATE after checking the instance and network path.
CLOUD_SQL_IP_TYPES=
SPRING_DATASOURCE_URL=jdbc:postgresql:///ax
# Uses the DB user's search_path. Add currentSchema only after confirming it.
SPRING_DATASOURCE_USERNAME=axox_app
# Cloud deployment: inject Secret Manager axox-db-password into this variable.
# Confirm the secret's owning project and version before configuring the reference.
# Local only: set the value in the ignored .env file; never commit it.
SPRING_DATASOURCE_PASSWORD=

# Optional JVM options are passed through at runtime, never at image build time.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# No AI Agent URL or API key is defined: the backend does not consume them yet.
